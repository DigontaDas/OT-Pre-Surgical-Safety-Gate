# SMART on FHIR App Configuration
# Copy this file to `.env` and edit the values

# FHIR server base URL (used by the demo data loader script only)
VITE_FHIR_BASE_URL=http://localhost:8080/fhir

# SMART client ID (registered with the EHR or SMART sandbox)
VITE_CLIENT_ID=ot-safety-gate

# OAuth scopes requested during launch
VITE_SCOPES=launch openid fhirUser patient/Patient.read patient/Procedure.read patient/Condition.read patient/Consent.read patient/AllergyIntolerance.read patient/Observation.read
